% ---- The switches ------------------------------------------------------------
% How the mini frames are spread in the bar:
% spreading (default), centering, left or right.
\NewDocumentCommand \SMMiniFramesSpreading { m }
  {
    \str_case:nnF {#1}
      {
        { spreading }
          {
            \renewcommand{\SMInsertNavlength}{
              \ifbool{SMZerosectionframes}{
                \hskip-0.5ex
              }{
                \hskip-1.875ex~plus-1fill
              }%
            }
            \renewcommand{\SMPatchInsertNav}{
              \box\beamer@sectionbox\hfil\hskip.3cm
            }
            \renewcommand{\SMPatchSectionentry}{
              \hskip1.875ex~plus~1fill
            }
          }
        { centering }
          {
            \renewcommand{\SMInsertNavlength}{
              \ifbool{SMZerosectionframes}{
                \hskip-0.5ex~plus~1fill
              }{
                \hfill
              }%
            }
            \renewcommand{\SMPatchInsertNav}{
              \box\beamer@sectionbox\hfill\hskip.3cm
            }
            \renewcommand{\SMPatchSectionentry}{
              \hskip~3.5ex
            }
          }
        { left }
          {
            \renewcommand{\SMInsertNavlength}{
              \ifbool{SMZerosectionframes}{
                \hskip-0.5ex
              }{
                \hskip-1.875ex~plus-1fill
              }%
            }
            \renewcommand{\SMPatchInsertNav}{
              \box\beamer@sectionbox\hfil\hskip.3cm
            }
            \renewcommand{\SMPatchSectionentry}{
              \hskip~3.5ex
            }
          }
        { right }
          {
            \renewcommand{\SMInsertNavlength}{
              \ifbool{SMZerosectionframes}{
                \hskip-0.5ex~plus~1fill
              }{
                \hskip-1.875ex~plus-1fill
              }%
            }
            \renewcommand{\SMPatchInsertNav}{
              \box\beamer@sectionbox\hfil\hskip.3cm
            }
            \renewcommand{\SMPatchSectionentry}{
              \hskip~3.5ex
            }
          }
      }
      { \msg_error:nnnn { SlideMage } { unknown-choice } {#1} { SMMiniFramesSpreading } }
  }

% What the mini frame bar shows next to the frames: none, section (default, beamer's
% own) or secsubsection (section and subsection names).
\NewDocumentCommand \SMMiniFramesSections { m }
  {
    \str_case:nnF {#1}
      {
        { none }
          {
            \__SM_set_template:nn { section~in~head/foot~shaded } { SMEmpty }
            \__SM_set_template:nn { section~in~head/foot } { SMEmpty }
            \renewcommand{\SMPatchSectionbox}{
              \ht\beamer@sectionbox=0pt
              \dp\beamer@sectionbox=0pt
            }
          }
        { section }
          {
            \__SM_set_template:nn { section~in~head/foot~shaded } { default }
            \__SM_set_template:nn { section~in~head/foot } { default }
          }
        { secsubsection }
          {
            \__SM_set_template:nn { section~in~head/foot~shaded } { SMSecSubsec }
            \__SM_set_template:nn { section~in~head/foot } { SMSecSubsec }
          }
      }
      { \msg_error:nnnn { SlideMage } { unknown-choice } {#1} { SMMiniFramesSections } }
  }

% Compress the mini frames of a section into one row: true (default) or false.
\NewDocumentCommand \SMMiniFramesCompress { m }
  {
    \str_case:nnF {#1}
      {
        { true }  { \beamer@compresstrue }
        { false } { \beamer@compressfalse }
      }
      { \msg_error:nnnn { SlideMage } { unknown-choice } {#1} { SMMiniFramesCompress } }
  }

\bool_new:N \g__SM_progbar_advancement_tlbr_bool
\bool_gset_true:N \g__SM_progbar_advancement_tlbr_bool
\bool_new:N \g__SM_pmfn_bool
\bool_gset_false:N \g__SM_pmfn_bool
\tl_new:N \g__SM_mfpos_tl
\tl_gset:Nn \g__SM_mfpos_tl { none }
\tl_new:N \g__SM_pbpos_tl
\tl_gset:Nn \g__SM_pbpos_tl { none }

% Direction of the progress bar: tlbr (left to right, top to bottom; default)
% or brlt.
\NewDocumentCommand \SMProgressBarDirection { m }
  {
    \str_case:nnF {#1}
      {
        { tlbr } { \bool_gset_true:N \g__SM_progbar_advancement_tlbr_bool }
        { brlt } { \bool_gset_false:N \g__SM_progbar_advancement_tlbr_bool }
      }
      { \msg_error:nnnn { SlideMage } { unknown-choice } {#1} { SMProgressBarDirection } }
  }

% rectangle (default) or rounded box.
\NewDocumentCommand \SMProgressBarStyle { m }
  {
    \str_case:nnF {#1}
      {
        { rectangle }
          {
            \__SM_set_template:nn { progress~bar~in~head/foot } { SMRectangle }
            \__SM_set_template:nn { progress~bar~in~left } { SMRectangle }
            \__SM_set_template:nn { progress~bar~in~right } { SMRectangle }
          }
        { rounded~box }
          {
            \__SM_set_template:nn { progress~bar~in~head/foot } { SMRoundedBox }
            \__SM_set_template:nn { progress~bar~in~left } { SMRoundedBox }
            \__SM_set_template:nn { progress~bar~in~right } { SMRoundedBox }
          }
      }
      { \msg_error:nnnn { SlideMage } { unknown-choice } {#1} { SMProgressBarStyle } }
  }

% true: the mini frames are drawn inside the progress bar (and the section
% names next to the mini frames are dropped); false (default): they are not.
\NewDocumentCommand \SMProgressBarMiniFrames { m }
  {
    \str_case:nnF {#1}
      {
        { true }
          {
            \bool_gset_true:N \g__SM_pmfn_bool
            \__SM_set_template:nn { section~in~head/foot~shaded } { SMEmpty }
            \__SM_set_template:nn { section~in~head/foot } { SMEmpty }
            \renewcommand{\SMPatchSectionbox}{
              \ht\beamer@sectionbox=0.ex
              \dp\beamer@sectionbox=0.ex
            }
            \__SM_install_nav_patches:
          }
        { false } { \bool_gset_false:N \g__SM_pmfn_bool }
      }
      { \msg_error:nnnn { SlideMage } { unknown-choice } {#1} { SMProgressBarMiniFrames } }
  }

% Rebuilds headline, frame title, footline and sidebars to their theme defaults
% and adds the mini frames and the progress bar where they are switched on.
\cs_new_protected:Nn \__SM_nav_apply:
  {
    \setbeamertemplate{headline}{}
    \setbeamertemplate{frametitle}[SMSubsameline]
    \setbeamertemplate{footline}[SMFootline]
    \setbeamertemplate{sidebar~left}{}
    \setbeamertemplate{sidebar~right}{}
    \exp_args:NV \str_case:nnF \g__SM_mfpos_tl
      {
        { head }
          { \addtobeamertemplate{headline}{}{\usebeamertemplate*{mini~nav~progress~head/foot}} }
        { foot }
          { \addtobeamertemplate{footline}{}{\usebeamertemplate*{mini~nav~progress~head/foot}} }
        { left }
          { \addtobeamertemplate{sidebar~left}{}{\usebeamertemplate*{mini~nav~progress~left}} }
        { right }
          { \addtobeamertemplate{sidebar~right}{}{\usebeamertemplate*{mini~nav~progress~right}} }
      }
      { }
    \exp_args:NV \str_case:nnF \g__SM_pbpos_tl
      {
        { head }
          { \addtobeamertemplate{headline}{}{\usebeamertemplate*{progress~bar~in~head/foot}} }
        { frametitle }
          { \addtobeamertemplate{frametitle}{}{\usebeamertemplate*{progress~bar~in~head/foot}} }
        { foot }
          { \addtobeamertemplate{footline}{}{\usebeamertemplate*{progress~bar~in~head/foot}} }
        { left }
          { \addtobeamertemplate{sidebar~left}{}{\usebeamertemplate*{progress~bar~in~left}} }
        { right }
          { \addtobeamertemplate{sidebar~right}{}{\usebeamertemplate*{progress~bar~in~right}} }
      }
      { }
  }

\NewDocumentCommand \SMMiniFramesPosition { m }
  {
    \str_case:nnF {#1}
      {
        { none } { }
        { head } { }
        { foot } { }
        { left } { }
        { right } { }
      }
      { \msg_error:nnnn { SlideMage } { unknown-choice } {#1} { SMMiniFramesPosition } }
    \tl_gset:Nn \g__SM_mfpos_tl {#1}
    \tl_if_eq:NnF \g__SM_mfpos_tl { none } { \__SM_install_nav_patches: }
    \__SM_nav_apply:
  }
\NewDocumentCommand \SMProgressBarPosition { m }
  {
    \str_case:nnF {#1}
      {
        { none } { }
        { head } { }
        { frametitle } { }
        { foot } { }
        { left } { }
        { right } { }
      }
      { \msg_error:nnnn { SlideMage } { unknown-choice } {#1} { SMProgressBarPosition } }
    \tl_gset:Nn \g__SM_pbpos_tl {#1}
    \__SM_nav_apply:
  }

