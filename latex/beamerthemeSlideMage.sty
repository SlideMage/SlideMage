}
\defbeamertemplate{section~in~head/foot~shaded}{SMEmpty}{
  \vspace{3.875ex}
}
\defbeamertemplate*{mini~nav~progress~head/foot}{SMMiniFrames}
{
\begin{beamercolorbox}[ignorebg]{section~in~head/foot}
\hfuzz=\paperwidth
\insertnavigation{\paperwidth}
\vspace{0.05cm}
\end{beamercolorbox}
}
\defbeamertemplate*{mini~nav~progress~left}{SMMiniFrames}
{
\settoheight{\SM@temp@heightFrametitle}{\SM@strut}
\addtolength{\SM@temp@heightFrametitle}{\SMFrametitleTopPadding+\SMFrametitleBottomPadding+\SMProgressHeadFootLineheight}

\setlength{\SM@temp@PaperheightFrametitle}{\paperheight-\SM@temp@heightFrametitle-\SMFootlineHeight-\SMFootlineDepth-\SMProgressHeadFootLineheight}

\vspace{-0.6\paperheight}
