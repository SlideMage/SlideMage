\RequirePackage{xcolor}

\definecolor[named]{SMLightOrange}{HTML}{EB811B}
\definecolor[named]{SMLightGreen}{HTML}{14B03D}
\definecolor[named]{SMDeepYellowOrange}{RGB}{255, 204, 0}
\definecolor[named]{SMAnthracite}{HTML}{2d3e50}
\definecolor[named]{SMPaleYellow}{RGB}{255, 255, 240}
\definecolor[named]{SMDarkBlack}{gray}{0.1}
\definecolor[named]{SMMidGrey}{gray}{0.5}

% The colour roles of the theme. \SMApplyColorRoles (below) redefines SMColorDark
% and SMColorA from the template's colours before it applies the roles.
\colorlet{SMColorPale}{SMPaleYellow}    % background
\colorlet{SMColorDark}{SMDarkBlack}     % foreground
\colorlet{SMColorA}{SMAnthracite}       % frame title bar, standout frame
\colorlet{SMColorB}{SMMidGrey}          % grey background: blocks
\colorlet{SMColorC}{SMDeepYellowOrange} % progress bars
\colorlet{SMColorD}{SMLightOrange}      % alert
\colorlet{SMColorE}{SMLightGreen}       % example

% Assigns the roles from the colours above (light background) and sets the
% beamer colours that follow them. Idempotent: call it after redefining
% SMColorPale .. SMColorE.
\cs_new_protected:Nn \__SM_apply_color_roles:
  {
    \colorlet{SMColorFG}{SMColorDark}
    \colorlet{SMColorBG}{SMColorPale}
    \colorlet{SMColorStandout}{SMColorA}
    \colorlet{SMColorFrametitle}{SMColorA}
    \colorlet{SMColorBackElement}{SMColorB}
    \colorlet{SMColorProgBar}{SMColorC}
    \colorlet{SMColorAlert}{SMColorD}
    \colorlet{SMColorExample}{SMColorE}
    \setbeamercolor{normal~text}{ fg=SMColorFG, bg=SMColorBG }
    \usebeamercolor[fg]{normal~text}
    \setbeamercolor{primary~palette}{
      use=normal~text,
      fg=normal~text.bg,
      bg=normal~text.fg
    }
  }
\__SM_apply_color_roles:

% The same for the template's palette: SlideMage_base.tex calls this after the
% template's colour definitions. The text colour and the title bar colour come
% from the palette (c_primary_dark) and the role \SMTitleBoxColor, the canvas is
% white unless the template defined SMCanvasColor (dark mode).
\NewDocumentCommand \SMApplyColorRoles { }
  {
    \colorlet{SMColorDark}{c_primary_dark}
    \colorlet{SMColorA}{\SMTitleBoxColor}
    \@ifundefinedcolor{SMCanvasColor}{\colorlet{SMCanvasColor}{white}}{}
    \__SM_apply_color_roles:
  }

\setbeamercolor{block~title}{ bg=c_secondary_violet, fg=c_primary_dark }
\setbeamercolor{block~body}{ bg=c_tertiary_gray, fg=c_primary_dark }
\setbeamercolor{alerted~text}{
  fg=SMColorAlert
}
\setbeamercolor{block~title~alerted}{ bg=c_secondary_red, fg=c_primary_dark }
\setbeamercolor{block~body~alerted}{ bg=c_tertiary_gray, fg=c_primary_dark }
\setbeamercolor{block~title~example}{ bg=c_secondary_green, fg=c_primary_dark }
\setbeamercolor{block~body~example}{ bg=c_tertiary_gray, fg=c_primary_dark }
\setbeamercolor{block~title~reference}{ bg=c_secondary_orange, fg=c_primary_dark }
\setbeamercolor{block~body~reference}{ bg=c_tertiary_gray, fg=c_primary_dark }
\setbeamercolor{block~title~info}{ bg=c_secondary_blue, fg=c_primary_dark }
\setbeamercolor{block~body~info}{ bg=c_tertiary_gray, fg=c_primary_dark }

\setbeamercolor{structure}{use=normal~text, fg=normal~text.fg}
\setbeamercolor{titlelike}{use=normal~text, parent=normal~text}
\setbeamercolor{section~in~toc}{use=normal~text, parent=normal~text}
\setbeamercolor{subsection~in~toc}{use=normal~text, parent=normal~text}
\setbeamercolor{subsubsection~in~toc}{use=normal~text, parent=normal~text}
\setbeamercolor{progress~bar}{
  use=alerted~text,
  fg=SMColorProgBar,
  bg=alerted~text.fg!50!black!30
}
\setbeamercolor{frametitle}{
  use=primary~palette,
  parent=primary~palette,
  bg=SMColorFrametitle,
  fg=\SMTitleTextColor
}
\setbeamercolor{progress~bar~in~head/foot}{
  use=progress~bar,
  parent=progress~bar
}
\setbeamercolor{progress~bar~in~part~page}{
  use=progress~bar,
  parent=progress~bar
}
\setbeamercolor{progress~bar~in~section~page}{
  use=progress~bar,
  parent=progress~bar
}
\setbeamercolor{progress~bar~in~splitvert}{
  use=progress~bar,
  parent=progress~bar
}
% The footnote text is the palette's dark colour, so that a link in it contrasts as in the body text.
\setbeamercolor{footnote}{fg=c_primary_dark}
\setbeamercolor{footnote~mark}{fg=.}

% Footer text, slide canvas and the buttons of \beamergotobutton and its relatives (white text on a
% solid pill in the hyperlink grey); the roles are the template's (SlideMage_setup.tex).
\setbeamercolor{footline}{fg=\SMFooterTextColor}
\setbeamercolor{background~canvas}{bg=SMCanvasColor}
\setbeamercolor{button}{bg=c_custom_gray, fg=white}
\setbeamercolor{button~border}{fg=c_custom_gray}
\setbeamercolor{SMFrametitleSection}{use=structure, fg=structure.bg}
\setbeamercolor{standout}{use=primary~palette, bg=SMColorStandout, fg=primary~palette.bg}

