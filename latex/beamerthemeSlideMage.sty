% progress bar in the section page
\newlength{\SM@progressonsectionpage}
\newlength{\SMProgressSectionHeight}
\setlength{\SMProgressSectionHeight}{3pt}

\defbeamertemplate{progress~bar~in~section~page}{empty}{
\vspace{\SMProgressSectionHeight+1ex}
}

% The progress bars count to 100 frames, as in Gotham (this replaces beamer's own total).
\def\inserttotalframenumber{100}
\defbeamertemplate{progress~bar~in~section~page}{display}{
\setlength{\SM@progressonsectionpage}{
\textwidth * \ratio{\insertframenumber~pt}{\inserttotalframenumber~pt}
}
\begin{tikzpicture}
\fill[bg] (0,0) rectangle (\textwidth, \SMProgressSectionHeight);
\fill[fg] (0,0) rectangle (\SM@progressonsectionpage, \SMProgressSectionHeight);
\end{tikzpicture}
}

\newlength{\SMSectionHOffset}
\setlength{\SMSectionHOffset}{0pt}

% the five looks
\defbeamertemplate{part~page}{SMProgressbarPage}{
\centering
\hspace*{\SMSectionHOffset}
\begin{minipage}{22em}
\centering
\usebeamertemplate*{part~title}\\[-1ex]
\usebeamertemplate*{progress~bar~in~section~page}
\par
\end{minipage}
\par
\vspace{\baselineskip}
}
\defbeamertemplate{section~page}{SMProgressbarPage}{
\centering
\hspace*{\SMSectionHOffset}
\begin{minipage}{22em}
\raggedright
\usebeamertemplate*{section~title}\\[-1ex]
\usebeamertemplate*{progress~bar~in~section~page}
\par
\end{minipage}
\par
\vspace{\baselineskip}
}
\defbeamertemplate{subsection~page}{SMProgressbarPage}{
\centering
\hspace*{\SMSectionHOffset}
\begin{minipage}{22em}
\raggedright
\usebeamertemplate*{section~title}\\[-1ex]
\usebeamertemplate*{progress~bar~in~section~page}
\par
\usebeamertemplate*{subsection~title}
\end{minipage}
\par
\vspace{\baselineskip}
}
\defbeamertemplate{subsubsection~page}{SMProgressbarPage}{
\centering
\hspace*{\SMSectionHOffset}
\begin{minipage}{22em}
\raggedright
\usebeamertemplate*{section~title}\\[-1ex]
\usebeamertemplate*{progress~bar~in~section~page}
\par
\usebeamertemplate*{subsection~title}
\par
\usebeamertemplate*{subsubsection~title}
\end{minipage}
\par
\vspace{\baselineskip}
}
\defbeamertemplate{background~canvas}{SMPart}{
\ifbeamercolorempty[bg]{normal~text}{}{\color{bg}\vrule width\paperwidth height\paperheight}
}
\defbeamertemplate{background~canvas}{SMSection}{
\setbeamertemplate{background~canvas}[SMPart]
\usebeamertemplate{background~canvas}
}
\defbeamertemplate{background~canvas}{SMSubsection}{
\setbeamertemplate{background~canvas}[SMPart]
\usebeamertemplate{background~canvas}
}
\defbeamertemplate{background~canvas}{SMSubsubsection}{
\setbeamertemplate{background~canvas}[SMPart]
\usebeamertemplate{background~canvas}
}
\defbeamertemplate{part~frame}{SMSimple}{
\setbeamertemplate{background~canvas}[SMPart]
\setbeamercolor{frametitle}{
use={frametitleSection, normal~text},
bg=frametitleSection.fg,
fg=normal~text.fg
}
\setbeamertemplate{progress~bar~in~section~page}[empty]
