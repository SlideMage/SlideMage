%% ---------------------------------------------------------------------------
%% Changes against beamertheme-gotham 1.2.5.a (LPPL 1.3c, section 6)
%% ---------------------------------------------------------------------------
%% 1. The five files beamer{,color,font,inner,outer}themegotham.sty are merged
%%    into this one file, in four sections: fonts, colors, inner, outer. Theme,
%%    file and package are renamed (SlideMage), so that nothing here can be
%%    mistaken for the original.
%% 2. Every name this file defines is renamed from gotham... to SM... (CamelCase;
%%    internal names \SM@... and \__SM_...), and the misspelt "pading" is
%%    corrected: \SMFrametitle{Top,Bottom,Left,Right}Padding, \SMFootlineVOffset,
%%    \SMInstituteLogo, \SMFrameSubtitleSep, \SMFrameSubtitleStrutEnd,
%%    \SM@frametitlestrut@start/@end, \SM@strut. The colour roles (colorA,
%%    colorDark, ...) became \SMColorA, \SMColorDark, ... and the Gotham palette
%%    SMAnthracite, SMPaleYellow, ... Beamer template variants are named SM....
%% 3. The \gothamset key interface and the option handling are removed. The
%%    configuration is fixed to what SlideMage used: light background, native
%%    blocks, anthracite colour set, no page numbering, no automatic divider
%%    frames. The features that stay switchable are switched by the commands
%%    documented in SlideMage_setup.tex (\SMMiniFramesPosition,
%%    \SMMiniFramesSpreading, \SMMiniFramesSections, \SMMiniFramesCompress,
%%    \SMProgressBarPosition, \SMProgressBarStyle, \SMProgressBarDirection,
%%    \SMProgressBarMiniFrames, \SMDividerFrames, \SMDividerLook,
%%    \SMWatermarkDefault, \SMWatermarkTemplate).
%% 4. Removed: \gothamreset; the title page and its variants; the table of
%%    contents templates and the automatic table-of-contents frames; side strips
%%    and edging; the rotated footer and the footer templates with date, title
%%    and author; the section headline; the round logo, the circle progress bar
%%    and the circle page numbering; the subnewline frame title and all
%%    continuation-title variants but the roman one; the frame-numbering styles
%%    other than none; the standin frame and its colours; the dark, red and
%%    transparent colour sets and block styles; the format (upper, lower,
%%    titlecase) and shape switches for titles and headings together with the
%%    patches of beamer's title, part, section, subsection and frame title
%%    commands that served them; the frame options noBGC, nologo, nofootline,
%%    nofooter, nopagenumber, edging, noedging, rotateFooter, noRotateFooter,
%%    standin and toc; the XeLaTeX and "OT"-named font fallbacks. The theme
%%    needs LuaLaTeX. The footline named a font ("page number in head/foot",
%%    written with spaces that expl3 syntax drops) that does not exist and did
%%    nothing; that call is gone.
%% 5. Mini frames, progress bars (head, frame title, foot, left, right; as
%%    rectangle or rounded box), the automatic part, section, subsection and
%%    subsubsection divider frames with their five looks, and the watermark
%%    background are kept, switched off by default. Their key plumbing (property
%%    lists, repeated reset blocks) is replaced by the commands of item 3. The
%%    patches that mini frames apply to beamer's \insertnavigation,
%%    \sectionentry and \slideentry are installed only when they are switched on.
%% ---------------------------------------------------------------------------
%%
\ProvidesExplPackage{beamerthemeSlideMage}{2026/10/26}{9.1.0}
  {SlideMage beamer theme, MODIFIED version derived from beamertheme-gotham 1.2.5.a by Romain NOEL}


