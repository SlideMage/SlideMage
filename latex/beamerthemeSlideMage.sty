\RequirePackage{calc}
\RequirePackage{tikz}

% ---- Frame options -------------------------------------------------------
% \__SM_add_frame_key:nn {<key>} {<environment>}: the frame option <key> opens
% <environment> at the start of the frame and closes it with the frame
% (beamer's \beamer@reseteecodes).
\seq_new:N \l__SM_frame_end_seq
\cs_new_protected:Nn \__SM_add_frame_key:nn
  {
    \define@key{beamerframe}{ #1 }[true]
      {
        \begin{#2}
        \seq_put_left:Nn \l__SM_frame_end_seq { \end{#2} }
      }
  }
\apptocmd{\beamer@reseteecodes}{
  \seq_use:Nn \l__SM_frame_end_seq {}
  \seq_clear:N \l__SM_frame_end_seq
}{}{}

% [c]: centre the frame vertically (also with automatic breaks).
\define@key{beamerframe}{c}[true]{
  \beamer@frametopskip=0pt~plus~1fill\relax
  \beamer@framebottomskip=0pt~plus~1fill\relax
  \beamer@frametopskipautobreak=0pt~plus~.4\paperheight\relax
  \beamer@framebottomskipautobreak=0pt~plus~.6\paperheight\relax
  \def\beamer@initfirstlineunskip{}
}

% ---- Standout frame: [standout] ------------------------------------------
\defbeamertemplate{background~canvas}{SMStandout}{
  \ifbeamercolorempty[bg]{standout}{
  }{
    \usebeamercolor[bg]{standout}\color{bg}
    \vrule~width\paperwidth~height\paperheight
  }
}
\defbeamertemplate*{standout}{SMDefault}{
  \setbeamertemplate{background~canvas}[SMStandout]
  \usebeamerfont{standout}
  \ifbeamercolorempty[bg]{primary~palette}{
    \setbeamercolor{background~canvas}{
      use=primary~palette,
      bg=primary~palette.fg
    }
  }{
    \setbeamercolor{background~canvas}{
      use=primary~palette,
      bg=primary~palette.bg
    }
  }
  \setbeamercolor{local~structure}{fg=primary~palette.bg}
  \usebeamercolor[fg]{primary~palette}
}
\newenvironment{SMStandoutFrame}{
  \usebeamertemplate{standout}
}{}
\__SM_add_frame_key:nn { standout } { SMStandoutFrame }

% ---- Watermark (off by default) ------------------------------------------
% \SMWatermarkDefault{true} puts it on every frame, [watermark] / [nowatermark]
% switch single frames; \SMWatermarkTemplate{<name>} picks the background
% template (SMDraft, or your own \defbeamertemplate{background}{<name>}).
\defbeamertemplate{background}{SMEmpty}{}
\defbeamertemplate{background}{SMDraft}{
  \begin{tikzpicture}[overlay,remember~picture]
    \node[color=red, opacity=0.3, scale=5, rotate=45] at ([shift={(0,0)}]current~page.center) {DRAFT};
  \end{tikzpicture}
}
\tl_new:N \g__SM_watermark_tl
\tl_gset:Nn \g__SM_watermark_tl { SMDraft }
\bool_new:N \g__SM_watermark_default_bool
\NewDocumentCommand \SMWatermarkTemplate { m }
  { \tl_gset:Nn \g__SM_watermark_tl {#1} }
\NewDocumentCommand \SMWatermarkDefault { m }
  {
    \str_case:nnF {#1}
      {
        { true }  { \bool_gset_true:N \g__SM_watermark_default_bool }
        { false } { \bool_gset_false:N \g__SM_watermark_default_bool }
      }
      { \msg_error:nnnn { SlideMage } { unknown-choice } {#1} { SMWatermarkDefault } }
  }
\BeforeBeginEnvironment{frame}{
  \bool_if:NTF \g__SM_watermark_default_bool
    { \setbeamertemplate{background}[\g__SM_watermark_tl] }
    { \setbeamertemplate{background}[SMEmpty] }
}
\newenvironment{SMWatermarkFrame}{
  \setbeamertemplate{background}[\g__SM_watermark_tl]
}{}
\__SM_add_frame_key:nn { watermark } { SMWatermarkFrame }
\newenvironment{SMNoWatermarkFrame}{
  \setbeamertemplate{background}[SMEmpty]
}{}
\__SM_add_frame_key:nn { nowatermark } { SMNoWatermarkFrame }

% ---- Text -----------------------------------------------------------------
\setlength{\parskip}{0.5em}
\linespread{1.15}

\defbeamertemplate*{itemize~item}{SMDefault}{
  \large
  \setbeamertemplate{itemize~item}[circle]
  \usebeamertemplate{itemize~item}
}
\defbeamertemplate*{itemize~subitem}{SMDefault}{
  \scriptsize
  \setbeamertemplate{itemize~subitem}[triangle]
  \usebeamertemplate{itemize~subitem}
}
\defbeamertemplate*{itemize~subsubitem}{SMDefault}{
  \Tiny
  $\blacksquare$
}

\defbeamertemplate*{caption~label~separator}{SMDefault}{:~}
\setbeamertemplate{caption}[numbered]

% ---- Divider frames (off by default) ----------------------------------------
% Beamer calls \AtBeginPart/\AtBeginSection/... at each \part/\section/...;
% \SMDividerFrames{<levels>} makes those insert a divider frame, and
% \SMDividerLook{<look>} picks how it looks: SMSimple, SMProgressbar,
% SMSplitvertSimple, SMSplitvertProgressbar or SMProgressvert.
\providebool{SMPartFrame}
\providebool{SMSectionFrame}
\providebool{SMSubsectionFrame}
\providebool{SMSubsubsectionFrame}
\cs_new_protected:Nn \__SM_add_divider_key:nnn
  {
    \define@key{beamerframe}{ #1 }[true]
      {
        \booltrue{SM#3Frame}
        \begingroup
        \usebeamertemplate{#2~frame}
      }
    \apptocmd{\beamer@reseteecodes}
      {
        \ifbool{SM#3Frame}
          {
            \endgroup
            \boolfalse{SM#3Frame}
          }
          {}
      }{}{}
  }
\__SM_add_divider_key:nnn { part } { part } { Part }
\__SM_add_divider_key:nnn { section } { section } { Section }
\__SM_add_divider_key:nnn { subsec } { subsection } { Subsection }
\__SM_add_divider_key:nnn { subsubsec } { subsubsection } { Subsubsection }

\providecommand{\SMPartPageOptions}{noframenumbering}
\providecommand{\SMSectionPageOptions}{noframenumbering}
\providecommand{\SMSubsectionPageOptions}{noframenumbering}
\providecommand{\SMSubsubsectionPageOptions}{noframenumbering}

% page titles of the divider frames
