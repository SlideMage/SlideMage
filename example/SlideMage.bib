% Master bibliography for SlideMage decks. Referenced via
% \addbibresource{SlideMage.bib} from decks that need it (biblatex + biber
% is opt-in per deck, not loaded globally in the template -- see
% README.md's "Decks with a bibliography" section for the extra biber step
% this adds).
%
% This is a trimmed copy: the original project's SlideMage.bib has ~900
% entries built up over years of real course/research decks; this one has
% just the single entry the manual's \fullcite{markowitz1952} demo (slide
% 1nz) needs. Add your own entries the
% same way -- entry keys are lowercase first-author surname + year.
%
% Entries are kept sorted alphabetically by key in the original project
% (not meaningful yet with only one entry here).

@article{markowitz1952,
	author       = {Markowitz, H.},
	title        = {Portfolio Selection},
	year         = {1952},
	journaltitle = {Journal of Finance},
	volume       = {7},
	number       = {1},
	pages        = {77--91},
}
