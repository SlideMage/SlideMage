% #1 the \AtBegin... command, #2 the page command, #3 the macro holding the
% frame options, #4 the frame option that selects the look.
\cs_new_protected:Npn \__SM_enable_divider:nnnn #1#2#3#4
  {
    \use:c {#1}
      {
        \ifbeamer@inframe
          \use:c {#2}
        \else
          \tl_if_empty:cTF {#3}
            { \frame [ c, #4 ] { \use:c {#2} } }
            {
              \edef \l__SM_divider_options_tmp { c, \use:c {#3} , #4 }
              \expandafter \frame \expandafter [ \l__SM_divider_options_tmp ] { \use:c {#2} }
            }
        \fi
      }
  }
\NewDocumentCommand \SMDividerFrames { m }
  {
    \AtBeginPart { }
    \AtBeginSection { }
    \AtBeginSubsection { }
    \AtBeginSubsubsection { }
    \clist_map_inline:nn {#1}
      {
        \str_case:nnF {##1}
          {
            { none } { }
            { part }
              { \__SM_enable_divider:nnnn { AtBeginPart } { partpage } { SMPartPageOptions } { part } }
            { section }
              { \__SM_enable_divider:nnnn { AtBeginSection } { sectionpage } { SMSectionPageOptions } { section } }
            { subsection }
              { \__SM_enable_divider:nnnn { AtBeginSubsection } { subsectionpage } { SMSubsectionPageOptions } { subsec } }
            { subsubsection }
              { \__SM_enable_divider:nnnn { AtBeginSubsubsection } { subsubsectionpage } { SMSubsubsectionPageOptions } { subsubsec } }
          }
          { \msg_error:nnnn { SlideMage } { unknown-choice } {##1} { SMDividerFrames } }
      }
  }
\NewDocumentCommand \SMDividerLook { m }
  {
    \clist_map_inline:nn { part, section, subsection, subsubsection }
      {
        \cs_if_exist:cTF { beamer@@tmpop@##1~frame@#1 }
          { \setbeamertemplate{##1~frame}[#1] }
          { \msg_error:nnnn { SlideMage } { unknown-choice } {#1} { SMDividerLook } }
      }
  }
\SMDividerLook { SMProgressbar }

