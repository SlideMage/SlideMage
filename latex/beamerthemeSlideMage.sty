\RequirePackage{xcolor}

\definecolor[named]{SMLightOrange}{HTML}{EB811B}
\definecolor[named]{SMLightGreen}{HTML}{14B03D}
\definecolor[named]{SMDeepYellowOrange}{RGB}{255, 204, 0}
\definecolor[named]{SMAnthracite}{HTML}{2d3e50}
\definecolor[named]{SMPaleYellow}{RGB}{255, 255, 240}
\definecolor[named]{SMDarkBlack}{gray}{0.1}
\definecolor[named]{SMMidGrey}{gray}{0.5}

% The colour roles of the theme. SlideMage_base.tex redefines SMColorDark and
% SMColorA from the template's colours and then calls \SMApplyColorRoles.
\colorlet{SMColorPale}{SMPaleYellow}    % background
\colorlet{SMColorDark}{SMDarkBlack}     % foreground
\colorlet{SMColorA}{SMAnthracite}       % frame title bar, standout frame
\colorlet{SMColorB}{SMMidGrey}          % grey background: blocks
\colorlet{SMColorC}{SMDeepYellowOrange} % progress bars
\colorlet{SMColorD}{SMLightOrange}      % alert
\colorlet{SMColorE}{SMLightGreen}       % example

% Assigns the roles from the colours above (light background) and sets the
% beamer colours that follow them. Idempotent: call it after redefining
% SMColorPale .. SMColorE.
\NewDocumentCommand \SMApplyColorRoles { }
  {
    \colorlet{SMColorFG}{SMColorDark}
    \colorlet{SMColorBG}{SMColorPale}
    \colorlet{SMColorStandout}{SMColorA}
    \colorlet{SMColorFrametitle}{SMColorA}
    \colorlet{SMColorBackElement}{SMColorB}
    \colorlet{SMColorProgBar}{SMColorC}
    \colorlet{SMColorAlert}{SMColorD}
    \colorlet{SMColorExample}{SMColorE}
    \setbeamercolor{normal~text}{ fg=SMColorFG, bg=SMColorBG }
    \usebeamercolor[fg]{normal~text}
    \setbeamercolor{primary~palette}{
      use=normal~text,
      fg=normal~text.bg,
      bg=normal~text.fg
    }
  }
\SMApplyColorRoles

% Native blocks: filled with the back-element grey, white text.
\setbeamercolor{block~title}{
  fg=SMColorPale,
  bg=SMColorBackElement!90!fg
}
\setbeamercolor{block~body}{
  use={block~title, normal~text},
  bg=block~title.bg!50!normal~text.bg
}
\setbeamercolor{alerted~text}{
  fg=SMColorAlert
}
\setbeamercolor{alertedBlock~text}{
  fg=SMColorPale
}
\setbeamercolor{example~text}{
  fg=SMColorPale
}
\setbeamercolor{block~title~alerted}{
  use={block~title, alertedBlock~text},
  bg=SMColorAlert,
  fg=alertedBlock~text.fg
}
\setbeamercolor{block~title~example}{
  use={block~title, example~text},
  bg=SMColorExample,
  fg=example~text.fg
}

\setbeamercolor{structure}{use=normal~text, fg=normal~text.fg}
\setbeamercolor{titlelike}{use=normal~text, parent=normal~text}
\setbeamercolor{section~in~toc}{use=normal~text, parent=normal~text}
\setbeamercolor{subsection~in~toc}{use=normal~text, parent=normal~text}
\setbeamercolor{subsubsection~in~toc}{use=normal~text, parent=normal~text}
\setbeamercolor{progress~bar}{
  use=alerted~text,
  fg=SMColorProgBar,
  bg=alerted~text.fg!50!black!30
}
\setbeamercolor{frametitle}{
  use=primary~palette,
  parent=primary~palette,
  bg=SMColorFrametitle
}
\setbeamercolor{progress~bar~in~head/foot}{
